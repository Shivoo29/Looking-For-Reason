# JobHack Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Authentication (choose one)
# Option 1: Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Option 2: NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Stripe Payment
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# =============================================================================
# BACKEND CONFIGURATION
# =============================================================================

# Server
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=change-this-to-a-random-secret-key
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Database
DATABASE_URL=postgresql://jobhack_user:jobhack_password@localhost:5432/jobhack_db

# Redis
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# AI SERVICES (choose at least one)
# =============================================================================

# Anthropic Claude (Recommended)
ANTHROPIC_API_KEY=

# OpenAI GPT-4
OPENAI_API_KEY=

# =============================================================================
# EMAIL SERVICES (choose one)
# =============================================================================

# SendGrid
SENDGRID_API_KEY=
FROM_EMAIL=noreply@jobhack.io

# Resend
RESEND_API_KEY=

# =============================================================================
# LINKEDIN (Optional - for org graph features)
# =============================================================================

LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=

# =============================================================================
# FILE STORAGE
# =============================================================================

# Local storage (default)
STORAGE_TYPE=local
UPLOAD_DIR=uploads

# AWS S3 (production)
# STORAGE_TYPE=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=jobhack-files
# AWS_REGION=us-east-1

# =============================================================================
# MONITORING & ANALYTICS (Optional)
# =============================================================================

# Sentry
SENTRY_DSN=

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# =============================================================================
# FEATURES FLAGS
# =============================================================================

ENABLE_LINKEDIN_SCRAPING=True
ENABLE_EMAIL_OUTREACH=True
ENABLE_ANALYTICS=True
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=60

# =============================================================================
# JWT AUTHENTICATION
# =============================================================================

JWT_SECRET_KEY=change-this-to-a-random-jwt-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
